{
  "name": "avocado-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && astro dev --host 127.0.0.1",
    "assets": "node scripts/sync-assets.mjs",
    "check": "astro check",
    "build": "npm run assets && astro build && node scripts/package-pages.mjs && node scripts/check-secrets.mjs",
    "preview": "node scripts/pages-cli.mjs dev ../site/pages-dist --port 4321 --ip 127.0.0.1 --persist-to ../site/.wrangler/state",
    "test": "node --test tests/*.test.*",
    "export:github": "node scripts/export-github-pages.mjs && node scripts/check-secrets.mjs --github",
    "test:ui": "node tests/site-ui.cjs",
    "dev:stack": "node scripts/dev-stack.mjs",
    "test:admin": "node tests/admin-ui.cjs",
    "db:local": "wrangler d1 migrations apply avocado-chat --local --config wrangler.build.jsonc",
    "db:remote": "wrangler d1 migrations apply avocado-chat --remote --config wrangler.build.jsonc",
    "admin:password": "node scripts/admin-password.mjs",
    "deploy": "npm run build && node scripts/pages-cli.mjs deploy ../site/pages-dist --project-name avocado-rest --branch main"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@cloudflare/workers-types": "5.20260911.1",
    "lighthouse": "^13.0.1",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "ultrahtml": "1.7.0",
    "wrangler": "^4.131.1"
  }
}
