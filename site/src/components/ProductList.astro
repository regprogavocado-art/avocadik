---
import type { Product, Country } from '../lib/content';
import ChatButton from './ChatButton.astro';
import { availabilityLabels, formatProductPrice } from './catalog';
interface Props { products: Product[]; countries?: Country[]; }
const { products, countries = [] } = Astro.props;
---
<div class="product-list">{products.map(product => {
  return <article class="product-row">
    <div>
      <span class:list={['status', `status-${product.availability}`]}>{availabilityLabels[product.availability] || 'По запросу'}</span>
      <h3><a href={`/catalog/${encodeURIComponent(product.category)}/${encodeURIComponent(product.slug)}`}>{product.title}</a></h3>
      <p>{product.summary}</p>
      {product.countryCodes.length > 0 && <div class="product-country">{product.countryCodes.map(code => countries.find(country => country.code === code)?.name || code).join(' · ')}</div>}
    </div>
    <div class="product-price">{formatProductPrice(product)}<small>{product.priceNote || (product.availability === 'soon' ? 'Готовится к запуску' : 'Условия в чате')}</small></div>
    <ChatButton variant="secondary" label={product.availability === 'soon' ? 'Узнать о запуске' : 'Уточнить условия'} text={`Здравствуйте! Интересует ${product.title}. ${product.availability === 'soon' ? 'Расскажите о планах запуска.' : 'Подскажите наличие и условия.'}`} />
  </article>;
})}</div>
<style>
  .product-price { white-space: normal; overflow-wrap: anywhere; line-height: 1.4; min-width: 0; }
  .product-price small { line-height: 1.6; }
</style>
