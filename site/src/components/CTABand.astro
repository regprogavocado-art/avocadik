---
import ChatButton from './ChatButton.astro';
interface Props { title?: string; description?: string; text?: string; }
const { title = 'Нужен хостинг?\nПоможем выбрать.', description = 'Подберём конфигурацию и локацию, подтвердим наличие и подготовим счёт. Без KYC, с оплатой криптовалютой.', text = 'Здравствуйте! Помогите подобрать хостинг для моего проекта.' } = Astro.props;
---
<section class="cta-section container">
  <div class="cta-band">
    <img src="/assets/img/cta-band.webp" srcset="/assets/img/cta-band-1200.webp 1200w, /assets/img/cta-band.webp 2073w" sizes="(max-width: 760px) 100vw, 90vw" width="2073" height="758" loading="lazy" decoding="async" alt="" class="cta-image" />
    <div class="cta-content"><h2 class="plain-text">{title.replace(/\\n/g, '\n')}</h2><p>{description}</p><ChatButton text={text} label="Написать в чат" /></div>
  </div>
</section>
