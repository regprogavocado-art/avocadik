---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ChatButton from '../components/ChatButton.astro';
import CategoryList from '../components/CategoryList.astro';
import CTABand from '../components/CTABand.astro';
import ProductScene from '../components/ProductScene.astro';
import { formatProductPrice } from '../components/catalog';
import { getSiteData } from '../lib/content';
const { pages, products, countries, settings } = await getSiteData(env);
const page = pages.find(page => page.slug === 'home');
if (!page) return Astro.rewrite('/404');
const headlineBreak = page.title.indexOf('.');
const hass = pages.find(page => page.slug === 'hass');
const ettinger = pages.find(page => page.slug === 'ettinger');
const rent = pages.find(page => page.slug === 'rent');
const offers = ['domains', 'vps', 'proxies'].map(category => products.find(product => product.category === category && product.price && product.availability !== 'soon')).filter((product): product is typeof products[number] => Boolean(product));
const principles = [
  { icon: 'shield', title: 'Защита от DDoS', text: 'Hass помогает защищать трафик и сохранять контроль над сервисами.', href: '/hass' },
  { icon: 'cpu', title: 'Автоматизация', text: 'Ettinger берёт на себя повторяющиеся операции и связывает процессы.', href: '/ettinger' },
  { icon: 'check-circle', title: 'Конфиденциальность', text: 'Работаем без KYC и проверки документов. Оплату принимаем в криптовалюте.', href: '/payment' },
  { icon: 'server', title: 'Абузоустойчивость', text: 'Bulletproof-хостинг — новое направление. Условия готовим к запуску.', href: '/catalog/bulletproof', soon: true },
];
const process = [
  { icon: 'telegram', title: 'Обсуждаем задачу', text: 'Цели, процессы и ограничения вашего проекта.' },
  { icon: 'layers', title: 'Предлагаем решение', text: 'Своё ПО, заказная разработка или нужные ресурсы.' },
  { icon: 'wallet', title: 'Согласуем условия', text: 'Объём работы, стоимость и удобную криптовалюту.' },
  { icon: 'route', title: 'Помогаем начать', text: 'Подключение, настройка и следующий этап развития.' },
];
---
<SiteLayout title={page.title} description={page.summary} settings={settings} hero>
  <div class="home-page">
    <section class="hero hero-monument">
      <div class="hero-visual" aria-hidden="true"><img src="/assets/img/hero-monument.webp" srcset="/assets/img/hero-monument-960.webp 960w, /assets/img/hero-monument.webp 1672w" sizes="100vw" width="1672" height="941" fetchpriority="high" decoding="async" alt=""/></div>
      <div class="hero-inner container"><div class="hero-copy">
        <p class="hero-kicker">Разработка · защита · автоматизация</p>
        <h1>{headlineBreak > 0 && headlineBreak < page.title.length - 2 ? <>{page.title.slice(0, headlineBreak + 1)}<span class="accent">{page.title.slice(headlineBreak + 1).trim()}</span></> : page.title}</h1>
        <p class="hero-lead">{page.summary}</p>
        <div class="hero-actions"><ChatButton label="Обсудить разработку" text="Здравствуйте! Хочу обсудить разработку ПО под свою задачу."/><a class="button button-secondary" href="#products">Наши продукты <Icon name="arrow"/></a></div>
        <ul class="hero-principles"><li><Icon name="shield"/><span>Без KYC и проверки документов</span></li><li><Icon name="wallet"/><span>Оплата криптовалютой</span></li><li><Icon name="check-circle"/><span>Конфиденциальная работа</span></li></ul>
      </div></div>
    </section>
    <section id="products" class="section home-products section-line"><div class="container">
      <div class="section-head"><div><p class="section-label">Программное обеспечение Avocado</p><h2>Наши продукты.</h2><p>{page.body || 'Два инструмента. Одна экосистема для вашей команды.'}</p></div><a class="text-link" href="/rent">Аренда панели <Icon name="arrow"/></a></div>
      <div class="solutions-grid">
        {hass && <article class="software-card software-card-hass"><div class="software-copy"><div class="software-heading"><span class="software-mark"><Icon name="shield"/></span><h3>{hass.title}</h3></div><p class="software-tagline">{hass.summary}</p><p class="software-description">{hass.body.split(/\r?\n\s*\r?\n/)[0]}</p><ul class="software-features"><li><Icon name="check-circle"/>Защита от DDoS-атак</li><li><Icon name="check-circle"/>Работа с блокировками РКН</li><li><Icon name="check-circle"/>Аналитика трафика</li></ul><a class="button button-secondary" href="/hass">Подробнее о Hass <Icon name="arrow"/></a></div><ProductScene product="hass"/></article>}
        {ettinger && <article class="software-card software-card-ettinger"><div class="software-copy"><div class="software-heading"><span class="software-mark"><Icon name="layers"/></span><h3>{ettinger.title}</h3></div><p class="software-tagline">{ettinger.summary}</p><p class="software-description">{ettinger.body.split(/\r?\n\s*\r?\n/)[0]}</p><ul class="software-features"><li><Icon name="check-circle"/>Массовые операции</li><li><Icon name="check-circle"/>ИИ-адаптеры и автоматизация</li><li><Icon name="check-circle"/>Управление инфраструктурой</li></ul><a class="button button-secondary" href="/ettinger">Подробнее об Ettinger <Icon name="arrow"/></a></div><ProductScene product="ettinger"/></article>}
      </div>
      <div class="custom-development"><span class="development-icon"><Icon name="cpu"/></span><div><h3>Ваш процесс. Наш код.</h3><p>Нужен отдельный инструмент, интеграция или собственная система? Разработаем ПО под вашу задачу.</p></div><ChatButton variant="secondary" label="Заказать разработку" text="Здравствуйте! Интересует заказная разработка ПО. Хочу обсудить свою задачу."/></div>
    </div></section>
    <section class="section home-guardian"><div class="container guardian-layout"><div class="guardian-art"><img src="/assets/img/avocado-guardian.webp" srcset="/assets/img/avocado-guardian-640.webp 640w, /assets/img/avocado-guardian.webp 1024w" sizes="(max-width: 760px) 330px, 440px" width="1024" height="1024" loading="lazy" decoding="async" alt="Авокадо на страже: персонаж Avocado с мятным щитом и золотыми узлами автоматизации"/></div><div class="guardian-content"><div class="section-head"><div><p class="section-label">Avocado на страже</p><h2>У вашего проекта<br/>есть защитник.</h2><p>Своя экосистема для защиты, автоматизации и конфиденциальной работы.</p></div></div><div class="guardian-directions">{principles.map(item => <a class="guardian-direction" href={item.href}><span class="principle-icon"><Icon name={item.icon}/></span><div><h3>{item.title}{item.soon && <span class="guardian-soon">Скоро</span>}</h3><p>{item.text}</p></div><Icon name="arrow"/></a>)}</div></div></div></section>
    <section class="section home-catalog section-line"><div class="container catalog-visual"><div class="catalog-intro"><p class="section-label">Инфраструктура для вашего ПО</p><h2>Всё для запуска.<br/><span class="gold">И следующего шага.</span></h2><p>Домены, VPS, выделенные серверы и прокси дополняют наши продукты. Подберём географию и ресурсы под ваш проект.</p><a class="text-link" href="/catalog">Каталог услуг <Icon name="arrow"/></a><a class="catalog-location-link" href="/countries"><Icon name="globe"/>География размещения <Icon name="arrow"/></a></div><CategoryList compact pages={pages} products={products}/></div></section>
    {offers.length > 0 && <section class="section home-offers section-line"><div class="container"><div class="section-head"><div><h2>Ориентиры по стоимости.</h2><p>Предварительные цены для первого расчёта. Наличие и итоговые условия подтвердим в чате.</p></div><a class="text-link" href="/catalog">Все предложения <Icon name="arrow"/></a></div><div class="offer-grid">{offers.map(offer => <article class="offer-card"><span class="section-label">{offer.category === 'domains' ? 'Домены' : offer.category === 'vps' ? 'Виртуальные серверы' : 'Прокси'}</span><h3>{offer.title}</h3><div class="offer-price">{formatProductPrice(offer)}</div>{offer.priceNote && <p class="offer-price-note">{offer.priceNote}</p>}<p>{offer.summary}</p>{offer.countryCodes.length > 0 && <div class="offer-geography"><Icon name="globe"/><span>{offer.countryCodes.slice(0, 4).map(code => countries.find(country => country.code === code)?.name || code).join(' · ')}{offer.countryCodes.length > 4 && ` и ещё ${offer.countryCodes.length - 4}`}</span></div>}<ChatButton variant="secondary" label="Уточнить условия" text={`Здравствуйте! Интересует ${offer.title}. Подскажите наличие и итоговые условия.`}/></article>)}</div></div></section>}
    {rent && <section class="section home-rent section-line"><div class="container"><div class="rent-feature"><div class="rent-feature-copy"><p class="section-label">Аренда панели</p><h2>Ваш рабочий инструмент.<br/><span class="gold">На нужный срок.</span></h2><p>{rent.summary}. Выберите возможности Hass и Ettinger под процессы вашей команды.</p><a class="button button-secondary" href="/rent">Об аренде панели <Icon name="arrow"/></a></div><img class="rent-feature-image" src="/assets/img/rent-card-600.webp" width="600" height="1066" alt="Золотая дорога среди ночных гор" loading="lazy" decoding="async"/></div></div></section>}
    <section class="section home-process"><div class="container"><div class="section-head"><div><h2>От задачи — к работающему решению.</h2><p>Начинаем с разговора. Остальное выстраиваем вокруг вашего проекта.</p></div></div><ol class="process-track">{process.map((step, index) => <li><div class="process-top"><span class="process-icon"><Icon name={step.icon}/></span>{index < process.length - 1 && <Icon name="arrow"/>}</div><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><a class="text-link process-payment-link" href="/payment">Как проходит оплата криптовалютой <Icon name="arrow"/></a></div></section>
    <CTABand title="Есть задача?\nДавайте создадим решение." description="Расскажите, что нужно вашему бизнесу. Начнём с понятного плана и подходящего инструмента." text="Здравствуйте! Хочу обсудить разработку или продукты Avocado."/>
  </div>
</SiteLayout>
