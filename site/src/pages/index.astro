---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ChatButton from '../components/ChatButton.astro';
import ProductScene from '../components/ProductScene.astro';
import CountryFlag from '../components/CountryFlag.astro';
import TariffGrid from '../components/TariffGrid.astro';
import DomainSearch from '../components/DomainSearch.astro';
import { formatProductPrice } from '../components/catalog';
import { getSiteData } from '../lib/content';
import { pricedProducts } from '../lib/hosting';
const { pages, products, countries, settings } = await getSiteData(env);
const page = pages.find(page => page.slug === 'home');
if (!page) return Astro.rewrite('/404');
const headlineBreak = page.title.indexOf('.');
const vps = pricedProducts(products, 'vps');
const hass = pages.find(page => page.slug === 'hass');
const ettinger = pages.find(page => page.slug === 'ettinger');
const definitions = [
  {category:'vps', title:'VPS-серверы', icon:'cpu', note:'Ресурсы для вашего проекта'},
  {category:'dedicated', title:'Выделенные серверы', icon:'server', note:'Собственные ресурсы целиком'},
  {category:'domains', title:'Домены', icon:'globe', note:'Регистрация на первый год'},
  {category:'proxies', title:'Прокси', icon:'route', note:'За 1 IP · выбор географии'},
];
const services = definitions.filter(service => pages.some(page => page.slug === `category-${service.category}`)).map(service => {
  const candidates = pricedProducts(products,service.category).filter(product => product.availability !== 'soon');
  const currency = candidates.some(product => product.priceCurrency === 'USD') ? 'USD' : candidates[0]?.priceCurrency;
  // Compare within one currency only; amounts in EUR and USD are never converted.
  const offer = candidates.filter(product => product.priceCurrency === currency).sort((a,b) => Number(a.price)-Number(b.price))[0];
  return {...service, price: offer ? `от ${formatProductPrice(offer)}` : 'По запросу'};
});
const serverCountries = ['FI','NL','SE','IS','CH','US'].flatMap(code => {
  const country = countries.find(country => country.code === code);
  const count = vps.filter(product => product.countryCodes.includes(code)).length;
  return country && count ? [{...country,count}] : [];
});
const steps = [
  {icon:'cart',title:'Заказ',text:'Выберите тариф и локацию. Отправьте заявку в чат.'},
  {icon:'invoice',title:'Счёт',text:'Подтвердим наличие, сумму, криптовалюту и сеть.'},
  {icon:'coins',title:'Криптооплата',text:'Переведите точную сумму на адрес из счёта.'},
  {icon:'server',title:'Доступ',text:'После подтверждения оплаты передадим данные услуги.'},
];
const faqs = [
  {question:'Как оплатить криптовалютой?',answer:'Выберите услугу и отправьте заявку. В чате согласуем криптовалюту и сеть, затем подготовим счёт с адресом кошелька и точной суммой. После перевода пришлите идентификатор транзакции — оператор подтвердит оплату.'},
  {question:'Нужны ли документы?',answer:'Avocado не запрашивает документы для проверки личности. Для заявки достаточно чата; данные, необходимые для запуска выбранной услуги, согласуем до оплаты.'},
  {question:'Как подтвердить наличие сервера?',answer:'Нажмите «Заказать» в карточке тарифа. Выбранная конфигурация и страна попадут в заявку. Мы подтвердим доступность, итоговую стоимость и срок выдачи перед выставлением счёта.'},
  {question:'Как проходит регистрация домена?',answer:'Введите имя и выберите зону в подборе домена. Запрос отправится оператору: он проверит доступность имени, цену первого года и продления. Оплата — после подтверждения; сам подбор не резервирует домен.'},
];
---
<SiteLayout title={page.title} description={page.summary} settings={settings} hero>
  <div class="hosting-home">
    <section class="hosting-hero">
      <div class="hosting-hero-art" aria-hidden="true"><img src="/assets/img/hero-monument.webp" srcset="/assets/img/hero-monument-960.webp 960w, /assets/img/hero-monument.webp 1672w" sizes="100vw" width="1672" height="941" fetchpriority="high" decoding="async" alt="" /></div>
      <div class="container hosting-hero-inner"><div class="hosting-hero-copy">
        <h1>{headlineBreak > 0 && headlineBreak < page.title.length - 2 ? <>{page.title.slice(0,headlineBreak+1)}<span>{page.title.slice(headlineBreak+1).trim()}</span></> : page.title}</h1>
        <p>{page.summary}</p>
        <div class="hosting-hero-actions"><a class="button button-primary" href="#vps-plans">Выбрать VPS <Icon name="arrow"/></a><a class="button button-secondary" href="#home-domain" data-focus-domain>Подобрать домен <Icon name="arrow"/></a></div>
      </div></div>
    </section>
    <div class="container hosting-entry">
      <nav class="service-band" aria-label="Услуги хостинга">{services.map(service=><a class="service-tile" href={`/catalog/${service.category}`}><Icon name={service.icon}/><div><h2>{service.title}</h2><p>{service.price}</p><small>{service.note}</small></div><Icon name="arrow"/></a>)}</nav>
      <DomainSearch products={products} id="home-domain" />
    </div>
    <section class="hosting-section hosting-plans container" id="vps-plans">
      <div class="hosting-section-head"><div><h2><span class="gold">VPS</span> под вашу задачу.</h2><p>Выберите конфигурацию и страну. Наличие подтвердим перед счётом.</p></div><a class="text-link" href="/catalog/vps">Все тарифы VPS <Icon name="arrow"/></a></div>
      <TariffGrid products={vps} countries={countries} id="home-vps" filters featured limit={4}/>
      <div class="hosting-plans-note"><p>{page.body}</p><a href="/payment" class="text-link">Как оплатить <Icon name="arrow"/></a></div>
    </section>
    {serverCountries.length > 0 && <section class="hosting-section hosting-geography container">
      <div class="hosting-section-head"><div><h2>Нужная страна.<br class="mobile-break"/> Понятный выбор.</h2><p>Локации VPS из нашего каталога. Выберите страну, чтобы увидеть её тарифы.</p></div><a class="text-link" href="/countries">Все страны и услуги <Icon name="arrow"/></a></div>
      <div class="hosting-country-grid">{serverCountries.map(country=><a class="hosting-country" href={`/catalog/vps/#country=${country.code}`}><CountryFlag code={country.code} name={country.name} decorative/><div><h3>{country.name}</h3><p>Тарифов VPS: {country.count}</p></div><Icon name="arrow"/></a>)}</div>
      <div class="hosting-country-footer"><p>Нужны выделенный сервер или прокси в другой стране?</p><ChatButton variant="text" label="Подобрать локацию" text="Здравствуйте! Хочу подобрать услугу и страну размещения. Помогите с выбором."/></div>
    </section>}
    {(hass || ettinger) && <section class="hosting-section hosting-software container" id="products">
      <div class="hosting-section-head"><div><h2>Своя инфраструктура.<br class="mobile-break"/> <span class="gold">Своё ПО.</span></h2><p>Hass и Ettinger дополняют хостинг защитой и автоматизацией.</p></div></div>
      <div class="hosting-software-grid">
        {hass && <article class="hosting-software-card"><div class="hosting-software-copy"><div class="hosting-software-title"><Icon name="shield"/><div><h3>{hass.title}</h3><p>Защита инфраструктуры</p></div></div><p>Контроль трафика, защита от DDoS и аналитика в собственном продукте Avocado.</p><ul><li><Icon name="check-circle"/>Фильтрация и защита трафика</li><li><Icon name="check-circle"/>Смягчение DDoS-атак</li><li><Icon name="check-circle"/>Аналитика и управление</li></ul><a class="button button-secondary" href="/hass">Подробнее о Hass <Icon name="arrow"/></a></div><ProductScene product="hass"/></article>}
        {ettinger && <article class="hosting-software-card hosting-software-gold"><div class="hosting-software-copy"><div class="hosting-software-title"><Icon name="layers"/><div><h3>{ettinger.title}</h3><p>Автоматизация процессов</p></div></div><p>Массовые операции, ИИ-адаптеры и управление инфраструктурой вашей команды.</p><ul><li><Icon name="check-circle"/>Массовые операции</li><li><Icon name="check-circle"/>ИИ-адаптеры и сценарии</li><li><Icon name="check-circle"/>Управление инфраструктурой</li></ul><a class="button button-secondary" href="/ettinger">Подробнее об Ettinger <Icon name="arrow"/></a></div><ProductScene product="ettinger"/></article>}
      </div>
      <div class="hosting-software-links"><a href="/rent" class="text-link">Аренда панели <Icon name="arrow"/></a><a href="/software" class="text-link">Разработка под вашу задачу <Icon name="arrow"/></a><a href="/catalog/bulletproof" class="text-link">Bulletproof-хостинг <span class="status status-soon">Скоро</span></a></div>
    </section>}
    <section class="hosting-section hosting-process container">
      <div class="hosting-section-head"><div><h2>От заказа до доступа.</h2><p>Один понятный процесс для VPS, серверов, доменов и прокси.</p></div></div>
      <ol>{steps.map((step,index)=><li><span class="hosting-step-icon"><Icon name={step.icon}/></span><div><h3><span>0{index+1}</span> {step.title}</h3><p>{step.text}</p></div>{(index < steps.length - 1) && <Icon name="arrow"/>}</li>)}</ol>
      <a class="text-link hosting-payment-link" href="/payment">BTC, ETH, USDT, XMR, LTC и другие валюты <Icon name="arrow"/></a>
    </section>
    <section class="hosting-section hosting-faq container">
      <div class="hosting-section-head"><h2>Вопросы перед заказом.</h2></div>
      <div class="hosting-faq-list">{faqs.map(faq=><details><summary>{faq.question}<Icon name="plus"/></summary><p>{faq.answer}</p></details>)}</div>
      <div class="hosting-help"><p>Остались вопросы или нужна нестандартная конфигурация?</p><ChatButton variant="secondary" label="Написать нам" text="Здравствуйте! Помогите подобрать хостинг и конфигурацию под мой проект."/></div>
    </section>
  </div>
</SiteLayout>
