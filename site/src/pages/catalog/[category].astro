---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ProductList from '../../components/ProductList.astro';
import ChatButton from '../../components/ChatButton.astro';
import CTABand from '../../components/CTABand.astro';
import BodyText from '../../components/BodyText.astro';
import Icon from '../../components/Icon.astro';
import { categories, safeImage, categorySrcSet } from '../../components/catalog';
import { getSiteData } from '../../lib/content';
const { pages, products, countries, settings } = await getSiteData(env);
const category = categories.find(category => category.slug === Astro.params.category);
if (!category) return Astro.rewrite('/404');
const page = pages.find(page => page.slug === `category-${category.slug}`);
if (!page) return Astro.rewrite('/404');
const selection = products.filter(product => product.category === category.slug);
const categoryImage = safeImage(selection.find(product => product.image)?.image);
const soon = selection.length > 0 ? selection.every(product => product.availability === 'soon') : 'soon' in category;
---
<SiteLayout title={page?.title || category.title} description={page?.summary || category.description} settings={settings}>
  <PageHeading title={page?.title || category.title} description={page?.summary || category.description} parent={{href:'/catalog',label:'Каталог'}} />
  <section class="section"><div class="container"><nav class="category-tabs" aria-label="Категории услуг">{categories.map(item => <a href={`/catalog/${item.slug}`} aria-current={category.slug === item.slug ? 'page' : undefined}>{item.title}</a>)}</nav><div class="category-detail"><div>{categoryImage && <img class="category-render" src={categoryImage} srcset={categorySrcSet(categoryImage)} sizes="(max-width: 760px) 100vw, 55vw" width="1600" height="900" loading="lazy" decoding="async" alt={category.title}/>}<BodyText text={page?.body || category.description}/>{category.details.length > 0 && <ul class="check-list">{category.details.map(detail => <li><Icon name="check"/>{detail}</li>)}</ul>}{soon && <p class="status status-soon">Скоро</p>}</div><aside class="detail-aside"><h2>{soon ? 'Следите за запуском' : 'Нужна помощь с выбором?'}</h2><p>{soon ? 'Расскажем о планах и доступных альтернативах в чате.' : 'Расскажите о задаче, желаемой локации и сроке. Уточним наличие и предложим условия.'}</p><ChatButton label={soon ? 'Узнать о запуске' : 'Обсудить задачу'} text={`Здравствуйте! Интересует ${category.title}. Подскажите ${soon ? 'планы запуска' : 'условия и наличие'}.`}/></aside></div>{selection.length > 0 ? <><div class="section-head"><h2>{soon ? 'Готовим к запуску' : 'Предложения'}</h2></div><ProductList products={selection} countries={countries}/></> : <div class="empty-state"><h2>{soon ? 'Готовим новое направление' : 'Подбор по запросу'}</h2><p>{soon ? 'Предложения появятся здесь после запуска.' : 'Расскажите о требованиях в чате. Уточним доступные конфигурации и стоимость.'}</p></div>}</div></section>
  <CTABand />
</SiteLayout>
