---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import ChatButton from '../components/ChatButton.astro';
import BodyText from '../components/BodyText.astro';
import CTABand from '../components/CTABand.astro';
import CountryFlag from '../components/CountryFlag.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../components/catalog';
import { getSiteData } from '../lib/content';
const { pages, products, countries, settings } = await getSiteData(env);
const page = pages.find(page => page.slug === 'countries');
if (!page) return Astro.rewrite('/404');
---
<SiteLayout title={page.title} description={page.summary} settings={settings}>
  <div class="hosting-category"><PageHeading title={page.title} description={page.summary}/>
  <section class="section"><div class="container">{countries.length ? <div class="hosting-country-grid">{countries.map(country => {const available=categories.filter(category => products.some(product => product.category === category.slug && product.countryCodes.includes(country.code)) && pages.some(page => page.slug === `category-${category.slug}`));return <article class="hosting-country-card"><div class="hosting-country-title"><CountryFlag code={country.code} name={country.name} decorative/><h2>{country.name}</h2></div><p>{available.length ? 'Направления в каталоге' : 'Размещение по запросу'}</p><div class="hosting-country-services">{available.map(category => <a href={`/catalog/${category.slug}/#country=${country.code}`}>{category.title}<Icon name="arrow"/></a>)}</div>{!available.length && <ChatButton variant="text" label="Подобрать размещение" text={`Здравствуйте! Нужна инфраструктура в стране ${country.name}. Подскажите варианты.`}/>}</article>})}</div> : <div class="tariff-empty"><Icon name="globe"/><h2>Подберём страну размещения</h2><p>Расскажите, где хотите разместить проект. Уточним доступные страны и конфигурации.</p><ChatButton label="Подобрать страну" text="Здравствуйте! Помогите подобрать страну размещения проекта."/></div>}<div class="hosting-countries-note"><p>Нажмите на услугу под нужным флагом, чтобы открыть тарифы этой страны. Доступность конкретной конфигурации или типа прокси подтвердим перед заказом.</p>{page.body && <div class="terms"><BodyText text={page.body}/></div>}</div></div></section></div><CTABand />
</SiteLayout>
