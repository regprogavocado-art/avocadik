---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import BodyText from '../../components/BodyText.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { getSiteData, listNews } from '../../lib/content';

const requestedPage = Math.max(1, Math.min(100000, Math.floor(Number(Astro.url.searchParams.get('page')) || 1)));
const [{ pages, settings }, { items, total }] = await Promise.all([getSiteData(env), listNews(env, requestedPage, 9)]);
const page = pages.find(page => page.slug === 'news');
if (!page) return Astro.rewrite('/404');
const pageCount = Math.max(1, Math.ceil(total / 9));
if (requestedPage > pageCount) return Astro.redirect(pageCount > 1 ? `/news?page=${pageCount}` : '/news');
const dateFormat = new Intl.DateTimeFormat('ru-RU', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<SiteLayout title={`${page?.title || 'Новости'}${requestedPage > 1 ? ` — страница ${requestedPage}` : ''}`} description={page?.summary} settings={settings}>
  <PageHeading title={page?.title || 'Новости'} description={page?.summary || 'Обновления Avocado, новые услуги и заметки команды.'}/>
  <section class="section"><div class="container">{items.length > 0 ? <div class="news-grid">{items.map(item => <article class="news-card">{item.mediaKey && <a href={`/news/${encodeURIComponent(item.slug)}`} tabindex="-1" aria-hidden="true"><img class="news-image" src={`/media/${item.mediaKey}`} width="640" height="400" loading="lazy" decoding="async" alt=""/></a>}<div class="news-meta"><time datetime={new Date(item.publishedAt).toISOString()}>{dateFormat.format(item.publishedAt)}</time>{item.pinned && <span><Icon name="pin"/> Закреплено</span>}</div><h2><a href={`/news/${encodeURIComponent(item.slug)}`}>{item.title}</a></h2>{item.excerpt && <p>{item.excerpt}</p>}<a class="text-link" href={`/news/${encodeURIComponent(item.slug)}`}>Читать новость <Icon name="arrow"/><span class="sr-only">: {item.title}</span></a></article>)}</div> : <div class="empty-state"><Icon name="news"/><h2>Здесь будут новости Avocado.</h2><p>Новые услуги, доступные локации и обновления продуктов. Пока свежие подробности можно узнать у команды в чате.</p><a class="text-link" href="/catalog">Посмотреть услуги <Icon name="arrow"/></a></div>}{pageCount > 1 && <nav class="pagination" aria-label="Страницы новостей">{requestedPage > 1 ? <a href={requestedPage === 2 ? '/news' : `/news?page=${requestedPage - 1}`}>Предыдущая</a> : <span/>}<span>Страница {requestedPage} из {pageCount}</span>{requestedPage < pageCount ? <a href={`/news?page=${requestedPage + 1}`}>Следующая <Icon name="arrow"/></a> : <span/>}</nav>}{page?.body && <div class="terms"><BodyText text={page.body}/></div>}</div></section>
  <CTABand />
</SiteLayout>
