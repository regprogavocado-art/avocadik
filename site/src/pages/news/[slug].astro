---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import BodyText from '../../components/BodyText.astro';
import Icon from '../../components/Icon.astro';
import { getSiteData, getNews } from '../../lib/content';

const [{ settings }, item] = await Promise.all([getSiteData(env), getNews(env, Astro.params.slug || '')]);
if (!item) return Astro.rewrite('/404');
const dateFormat = new Intl.DateTimeFormat('ru-RU',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const sourceUrl = /^https:\/\/t\.me\//.test(item.sourceUrl) ? item.sourceUrl : '';
---
<SiteLayout title={item.title} description={item.excerpt} settings={settings}>
  <PageHeading title={item.title} parent={{href:'/news',label:'Новости'}}/>
  <article class="container news-article section"><div class="news-meta"><time datetime={new Date(item.publishedAt).toISOString()}>{dateFormat.format(item.publishedAt)}</time>{item.pinned && <span><Icon name="pin"/> Закреплено</span>}</div>{item.mediaKey && <img class="news-article-image" src={`/media/${item.mediaKey}`} width="1200" height="750" alt="Иллюстрация к новости" decoding="async"/>}<BodyText text={item.body}/>{sourceUrl && <div class="article-source"><a class="text-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">Публикация в Telegram <Icon name="arrow"/></a></div>}<div class="article-source"><a class="text-link" href="/news">Все новости <Icon name="arrow"/></a></div></article>
</SiteLayout>
